# Copy to .env.local and adjust.
# NEXT_PUBLIC_* values ship to the browser: never put a secret in them. Server-only values have no prefix.

# mainnet-beta | devnet | testnet | localnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# api.mainnet-beta.solana.com (the default when this is empty) answers 403 to browsers: set this.
#   Free, no key, tested:  https://solana-rpc.publicnode.com
#     works for: launching a coin on Pump.fun, the network check, the clock, balances, confirmations, activity.
#     does NOT allow: getProgramAccounts, getTokenLargestAccounts, getParsedTokenAccountsByOwner. Once the Deed program is
#     deployed the lists (auctions, coins, OTC) need getProgramAccounts, so switch to a keyed RPC then (Helius, QuickNode,
#     Triton: all have free tiers). Restrict a keyed URL to your domain: this value ships to every visitor's browser.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Optional sanity check. The program id is compiled into the program and shipped in src/chain/idl/deed_fun.json; if you set
# this it must be the same, otherwise the app refuses to start rather than talk to the wrong program.
NEXT_PUBLIC_DEED_PROGRAM_ID=

# Priority fee (micro-lamports per compute unit) added to every transaction so it lands when the network is busy.
# 0 disables it. A 400k-unit launch transaction at 20000 costs 8,000 lamports.
NEXT_PUBLIC_PRIORITY_FEE_MICROLAMPORTS=20000

# Public IPFS gateway used to show coin images and metadata (ipfs:// and bare CIDs are rewritten to it).
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Canonical site URL (metadata, and the locked "Website" link on launched coins).
NEXT_PUBLIC_SITE_URL=https://deed.fun

# ---- SERVER ONLY ----------------------------------------------------------------------------------------------------
# Pinata JWT used by /api/metadata to pin a new coin's image and metadata to IPFS. Without it launching answers
# "Metadata hosting is not configured" and creates nothing. Create one with the pinFileToIPFS + pinJSONToIPFS scopes only.
PINATA_JWT=

# ---- TESTS ONLY (never set on a real deployment) ---------------------------------------------------------------------
# Base58 secret key of an in-browser "E2E Burner" wallet for automated browser tests against a local validator.
# Ignored when NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta.
# NEXT_PUBLIC_E2E_BURNER_SECRET=
